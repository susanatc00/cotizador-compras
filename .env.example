# Copia este archivo a ".env" y completa los valores:
#   cp .env.example .env
# El archivo .env está en .gitignore: nunca lo subas al repositorio.

# === OpenAI (opcional: sin clave el sistema usa las reglas de respaldo) ===
OPENAI_API_KEY=sk-...
# Debe soportar Structured Outputs (json_schema estricto).
OPENAI_MODEL=gpt-4.1-mini
# Vacío para no enviar temperatura (los modelos gpt-5* solo aceptan la de defecto).
OPENAI_TEMPERATURE=0
# OPENAI_BASE_URL=

# === LangSmith (opcional: trazas del grafo) ===
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cotizador-compras
