# Copiar en Streamlit Community Cloud: App settings → Secrets
# (en local se puede usar .env o copiar este archivo a .streamlit/secrets.toml, que está en .gitignore)
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4.1-mini"
OPENAI_TEMPERATURE = "0"
# Código que habilita el LLM en la app pública (sin él, la app usa reglas y no gasta la clave)
CODIGO_ACCESO = "elige-un-codigo"
